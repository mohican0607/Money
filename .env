# 휴리스틱 점수 가산 세기
# THEME_CARRYOVER_ENABLED=0 이면 주식 주제 변경시 주제 변경이 되지 않음.
# THEME_CARRYOVER_ENABLED=0


###############################################################################
PRED_RANKING_MODE              =1       # 1         랭킹 모드 ON
PRED_USE_DISPLAY_RANK_MAPPING  =0       # 0         레거시 20~35% 매핑 OFF
PRED_ML_HIGH_CONFIDENCE_PROB   =0.10    # 하이브리드 고확신 하한
PRED_OUTPUT_MAX                =10
PRED_ML_POOL_MIN_KEYWORD_HITS  =1
PRED_ML_HIGH_RELATIVE_PROB     =0.68
PRED_PRECISION_GATE_ENABLED    =1       # 1이면 고확신 재필터(너무 빡세면 후보 0건)   ### 0 -> 1 변경 (2026.06.23)
PRED_FORWARD_SHOW_MAX          =15
PRED_REGIME_KS11_SOFT_MIN      =-0.025  # -0.025    KOSPI 약세 시 보수 모드

###############################################################################

### https://developers.naver.com/apps/#/myapps/CZ1fNuY7CbTu9ygZ2EgX/overview


USE_GOOGLE_NEWS_RSS_FALLBACK=1

### ML 랭커
###     적중률 개선을 쓰려면 PRED_USE_ML_RANKER=1(기본)과 
###     학습된 move_ranker_v2_*.joblib이 있어야 합니다.
PRED_USE_ML_RANKER=1

# 학습 데이터 시작일(YYYYMMDD). 비우면 2025-04-11.
# TRAIN_START=20250411

# ML 학습에 쓸 최근 N거래일. 0=TRAIN_START~T 직전 전구간(느림). 기본 120.
# ML_TRAIN_LOOKBACK_DAYS=0
# ML_TRAIN_LOOKBACK_DAYS=120

# 365일로 하려면...
# ML_TRAIN_LOOKBACK_DAYS=365
# ML_PIPELINE_ALWAYS_FAST_TRAIN=0

# 14:30 라이브(필수): 예측전용일은 직전 가용 모델 재사용 · 과거일 자동백필 금지
ML_REUSE_PRIOR_FOR_FORWARD=1
PIPELINE_AUTO_SUPPLEMENT_STALE_FORWARD=0
# 백테스트 정확도용 전일 맞춤 재학습을 쓰려면 장후에만:
# ML_REUSE_PRIOR_TRADING_DAY_MODEL=0
# PIPELINE_AUTO_SUPPLEMENT_STALE_FORWARD=1



### 리포트 예측 상승률
###   PRED_RETURN_MIN = _float_env("PRED_RETURN_MIN", 0.20)
###   PRED_RETURN_MAX = _float_env("PRED_RETURN_MAX", 0.35)
###   PRED_RETURN_MAX=0.30



### Google RSS **쿼리 묶음** 사이 대기 초(기본 0.09). 너무 낮추면 차단 위험
GOOGLE_NEWS_RSS_QUERY_SLEEP_SEC=0.2



# 뉴스 없이 주식·리포트만 돌릴 때 1
MOCK_NEWS=0


# 디버깅: 상위 N개 종목만 가격 다운로드. 리포트의 「실제 20%↑」를 전 시장에 맞출 때는 비우거나 주석 처리.
# SAMPLE_TICKERS=200
SAMPLE_TICKERS=0
SAMPLE_TICKERS_N=0

# 빠른 시험: 테스트 거래일 수 제한 (0 또는 비우면 전체)
# MAX_TEST_DAYS=5


# 수집 속도(선택): 전종목 OHLCV 병렬 스레드(기본 12). 회선이 느리면 6~8
# OHLCV_MAX_WORKERS=12
# OHLCV_MAX_WORKERS=1 <- 1보다 크게 하니  200개도 못받고 중간에 멈추어서 1로 변경하였음. -> 가격 다운로드(캐시 보강) 너무 오래걸려 12로 변경해봄
# 가격 다운로드(캐시 보강) - 3분정도 소요됨
#OHLCV_MAX_WORKERS=1 -> 전체 보강이 매우 오래 걸림. 정확도/성능 균형을 위해 최소 6~12로 올리는 걸 권장
#OHLCV_MAX_WORKERS=6 -> 6으로하면 멈춰버림.
OHLCV_MAX_WORKERS=1


# 뉴스는 날짜별 파일(day_*.json) 단위로 병렬(기본 4). both 모드에서는 2 권장
# NEWS_FETCH_MAX_WORKERS=4
# NEWS_FETCH_MAX_WORKERS=2 <- main.py 실행시 너무 오래 걸림
NEWS_FETCH_MAX_WORKERS=2


# 네이버 뉴스: market(기본)=일자+증시 키워드 | ticker=종목별 {종목명} YYYY년 M월 D일 (네이버 키 필수)
# NEWS_NAVER_QUERY_MODE=market
# 종목별 모드 시 하루 안에서 종목 쿼리 병렬 수·종목당 페이지(100건/페이지, 최대 10)
# NEWS_TICKER_NAVER_MAX_WORKERS=8  -> 2
# NEWS_TICKER_NAVER_MAX_PAGES=2 -> 5 정도가 비용 대비 체감 개선이 큰 편. 상한값인 10 으로 변경함.
#   NEWS_TICKER_NAVER_MAX_PAGES, NEWS_NAVER_MARKET_MAX_PAGES를 올리면(최대 10) 
#  그날 기사가 더 많이 들어갈 수 있습니다. 429가 나면 줄여야 합니다.
#  config.py에 10으로 상한이 정해져 있네.. NEWS_TICKER_NAVER_MAX_PAGES = min(10, _positive_int_env("NEWS_TICKER_NAVER_MAX_PAGES", 5))
NEWS_TICKER_NAVER_MAX_WORKERS=2
NEWS_TICKER_NAVER_MAX_PAGES=10

# market  vs  ticker  --> both (시장뉴스 market + 종목뉴스 ticker)
#  market (기본)   2026년 4월 10일 증시        적은 호출, 시장 전체 뉴스 풀
#  ticker         2026년 4월 10일 삼성전자    종목 단위 검색 (호출·시간 많이 듦)
# NEWS_NAVER_QUERY_MODE=ticker
# NEWS_NAVER_QUERY_MODE=both
NEWS_NAVER_QUERY_MODE=both


# 장후(실제값 확정 후) 리포트는 표를 만들 때, actual_big_movers(실제 20%↑ 종목) 전부를 먼저 넣고 그 다음 예측 후보를 합칩니다.
# 그래서 장중에는 없던 종목도, 장후에 실제 급등이 확정되면 추가됩니다.
#   cf> 서남의 26.46%는 “장중에 예측돼서 남아있던 값”이 아니라,
#  장후에 actual_big_movers 루프에서 **참고 예측치(완화 조건 포함)**를 다시 계산해 붙은 값입니다.
#  즉 질문하신 현상은 “뉴스가 달라서”가 아니라, 리포트 구성 규칙이 ‘예측만’이 아니라 ‘실제 급등 포함’이라서 발생한 겁니다.
#INCLUDE_ACTUAL_BIG_MOVERS_IN_ROWS_COMPARE=1 설정하면 기존 방식(실제 급등 포함)으로 복귀합니다.





