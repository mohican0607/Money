PYTHONIOENCODING='utf-8'
PYTHONUTF8='1'

# 실행 중 OS·joblib·tempfile 임시 파일 경로 (C: 대신 F: 사용)
MONEY_TEMP_DIR=F:\temp\Money\tmp
# ML joblib·학습 스냅샷·업종 API 캐시 (뉴스·OHLCV는 data/cache 유지)
MONEY_CACHE_DIR=F:\temp\Money\cache

# 네이버 개발자센터에서 발급 (https://developers.naver.com/apps/#/register)
# 비워 두면 기본으로 Google News RSS로 일자별 뉴스 수집(키 불필요). 끄려면 USE_GOOGLE_NEWS_RSS_FALLBACK=0

